# Set these in the Vercel project (Settings → Environment Variables), never in
# a VITE_* variable: nothing here may reach the browser. `npm run dev` needs
# none of them; it edits the files on disk instead.

# The admin's own address, exactly as the browser sends it as Origin.
ADMIN_ORIGIN=https://chi-square-admin.vercel.app

# Neon: added for you by Vercel's Neon integration.
DATABASE_URL=

# GitHub OAuth App for signing in. Callback URL: <ADMIN_ORIGIN>/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub logins (comma-separated) who are always owners. Everyone else is added
# from the Members page.
ADMIN_OWNERS=

# Publishing. Either a fine-grained token with Contents: read and write on this
# one repository...
GITHUB_TOKEN=
# ...or a GitHub App installed on it (the App wins when both are set).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# The branch a publish commits to. Vercel redeploys the site from it.
PUBLISH_BRANCH=main
